# Конфигурация OpenAI-совместимого API для Sleep Cycle (консолидация заметок)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-your-key-here
LLM_MODEL=gpt-4o
LLM_FALLBACK_MODEL=gpt-4o-mini
# Корень хранилища. connect.sh подставляет сюда реальный путь (<проект>/.brain).
BRAIN_ROOT=/path/to/your/project/.brain

# Ключ API Google Gemini для семантического обогащения графа знаний в Graphify
# (Используется при запуске полной экстракции: graphify extract или /graphify --update)
GEMINI_API_KEY=AIzaSy...
GOOGLE_API_KEY=AIzaSy...

